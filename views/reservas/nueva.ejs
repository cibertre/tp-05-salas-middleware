<% if (errores && errores.length > 0) { %>
    <div class="alerta" role="alert">
        <p>Revisá los siguientes datos:</p>
        <ul>
            <% errores.forEach((mensaje) => { %>
                <li><%= mensaje %></li>
            <% }); %>
        </ul>
    </div>
<% } %>

<form class="formulario" action="/reservas" method="POST" novalidate>
    <div class="campo">
        <label for="estudiante">Estudiante</label>
        <input
            type="text"
            id="estudiante"
            name="estudiante"
            value="<%= valores.estudiante || '' %>"
            required
        />
    </div>

    <div class="campo">
        <label for="email">Email</label>
        <input
            type="email"
            id="email"
            name="email"
            value="<%= valores.email || '' %>"
            required
        />
    </div>

    <div class="campo">
        <label for="sala">Sala de Estudio</label>
        <select id="sala" name="sala" required>
            <option value="" disabled <%= !valores.sala ? "selected" : "" %>>Elegí una sala</option>
            <% salas.forEach((sala) => { %>
                <option value="<%= sala %>" <%= valores.sala === sala ? "selected" : "" %>>
                    <%= sala %>
                </option>
            <% }); %>
        </select>
    </div>

    <div class="campo">
        <label for="fecha">Fecha</label>
        <input
            type="date"
            id="fecha"
            name="fecha"
            value="<%= valores.fecha || '' %>"
            required
        />
    </div>

    <div class="campo">
        <label for="turno">Turno</label>
        <select id="turno" name="turno" required>
            <option value="" disabled <%= !valores.turno ? "selected" : "" %>>Elegí un turno</option>
            <% turnos.forEach((turno) => { %>
                <option value="<%= turno %>" <%= valores.turno === turno ? "selected" : "" %>>
                    <%= turno %>
                </option>
            <% }); %>
        </select>
    </div>

    <div class="campo">
        <label for="personas">Personas</label>
        <input
            type="number"
            id="personas"
            name="personas"
            min="1"
            max="6"
            value="<%= valores.personas || '' %>"
            required
        />
    </div>

    <button type="submit" class="boton">Confirmar reserva</button>
</form>